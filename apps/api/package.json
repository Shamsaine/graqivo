{
  "name": "@graqivo/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/foundation.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "test:database": "vitest run test/database.test.ts",
    "test:phase2": "vitest run test/phase2.test.ts --testTimeout=30000 --hookTimeout=60000",
    "test:email": "vitest run test/email.test.ts",
    "test:phase3": "vitest run test/phase3.test.ts --testTimeout=30000 --hookTimeout=60000",
    "storage:init": "tsx src/storage/provision.ts",
    "test:phase4": "vitest run test/phase4.test.ts --testTimeout=30000 --hookTimeout=60000",
    "storage:local-config": "tsx src/storage/local-config.ts",
    "test:phase5": "vitest run test/phase5.test.ts --testTimeout=30000 --hookTimeout=60000"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "6.19.0",
    "better-auth": "1.7.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.0",
    "helmet": "^8.1.0",
    "nodemailer": "^10.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "yauzl": "^3.4.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.3",
    "@types/yauzl": "^3.4.0",
    "prisma": "6.19.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "type": "module"
}
