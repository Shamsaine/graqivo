# Environment configuration grouped by purpose.
# Keep secrets in ignored local env files or deployment secret settings.
# Copy to the corresponding local env file and replace placeholders.

# -----------------------------------------------------------------------------
# APPLICATION RUNTIME
# API environment and listening port.
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_ENV=local
PORT=4000

# -----------------------------------------------------------------------------
# FRONTEND ACCESS AND CORS
# Frontend URL and permitted browser origins.
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# ACTIVE DATABASE
# Current API database connection.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://graqivo:REPLACE_WITH_LOCAL_PASSWORD@localhost:55439/graqivo

# -----------------------------------------------------------------------------
# NEON DEPLOYMENT PLACEHOLDERS
# Hosted pooled/direct connections; deployment wiring will be finalized in Phase 7.
# -----------------------------------------------------------------------------
NEON_DATABASE_URL=
NEON_DIRECT_DATABASE_URL=

# -----------------------------------------------------------------------------
# AUTHENTICATION
# Signing secret and authentication API base URL.
# -----------------------------------------------------------------------------
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# EMAIL - SMTP
# Verification, reset and invitations; local Mailpit or hosted authenticated SMTP.
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_NAME=Graqivo
EMAIL_FROM_ADDRESS=

# -----------------------------------------------------------------------------
# EMAIL - OPTIONAL RESEND PLACEHOLDER
# Resend API adapter is not implemented; SMTP is the active delivery method.
# -----------------------------------------------------------------------------
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# STORAGE PROVIDER AND LIMITS
# Private storage selection, signed download lifetime and upload size.
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=s3
STORAGE_SIGNED_URL_TTL_SECONDS=120
MAX_UPLOAD_SIZE_MB=25

# -----------------------------------------------------------------------------
# STORAGE - GENERIC S3
# Current local private storage; align access credentials with root Compose settings.
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9010
S3_ACCESS_KEY_ID=graqivo_local
S3_SECRET_ACCESS_KEY=REPLACE_WITH_LOCAL_STORAGE_PASSWORD
S3_BUCKET_NAME=graqivo-local

# -----------------------------------------------------------------------------
# STORAGE - MINIO COMPATIBILITY
# MinIO adapter settings; legacy root names also configure local SeaweedFS.
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=http://localhost:9010
MINIO_ROOT_USER=graqivo_local
MINIO_ROOT_PASSWORD=REPLACE_WITH_LOCAL_STORAGE_PASSWORD
MINIO_BUCKET_NAME=graqivo-local
MINIO_REGION=us-east-1
MINIO_FORCE_PATH_STYLE=true

# -----------------------------------------------------------------------------
# STORAGE - HOSTED CLOUDFLARE R2
# Private bucket endpoint and bucket-scoped access credentials.
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# -----------------------------------------------------------------------------
# GOOGLE OAUTH - NOT IMPLEMENTED
# Reserved optional settings. Adding credentials alone does not enable Google login.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# -----------------------------------------------------------------------------
# OBSERVABILITY PLACEHOLDERS
# Reserved logging/error reporting settings; these alone do not enable monitoring.
# -----------------------------------------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=

# -----------------------------------------------------------------------------
# ISOLATED INTEGRATION TEST DATABASE
# Separate test database; never use the production or application database here.
# -----------------------------------------------------------------------------
TEST_DATABASE_URL=postgresql://graqivo:REPLACE_WITH_LOCAL_PASSWORD@localhost:55439/graqivo_test
