NODE_ENV=development
APP_ENV=local
PORT=4000
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://graqivo:REPLACE_WITH_LOCAL_PASSWORD@localhost:55439/graqivo
# Phase 2 auth configuration; never put secrets in chat.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_NAME=Graqivo
EMAIL_FROM_ADDRESS=
RESEND_API_KEY=
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=http://localhost:9010
MINIO_ROOT_USER=graqivo_local
MINIO_ROOT_PASSWORD=REPLACE_WITH_LOCAL_STORAGE_PASSWORD
MINIO_BUCKET_NAME=graqivo-local
MINIO_REGION=us-east-1
MINIO_FORCE_PATH_STYLE=true
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
STORAGE_SIGNED_URL_TTL_SECONDS=120
MAX_UPLOAD_SIZE_MB=25
# Hosted deployment and optional Google OAuth; not active in Phase 1.
NEON_DATABASE_URL=
NEON_DIRECT_DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
LOG_LEVEL=info
SENTRY_DSN=

# Isolated integration tests only; create and migrate this database before running.
TEST_DATABASE_URL=postgresql://graqivo:REPLACE_WITH_LOCAL_PASSWORD@localhost:55439/graqivo_test
