# Environment configuration grouped by purpose.
# Store secrets only in ignored local files or deployment secret settings.
# Copy to the corresponding local env file and replace placeholders before use.

# -----------------------------------------------------------------------------
# LOCAL POSTGRESQL - DOCKER COMPOSE
# Local database password and host port; match the API database connection.
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
POSTGRES_PORT=55439

# -----------------------------------------------------------------------------
# LOCAL PRIVATE STORAGE - DOCKER COMPOSE
# Legacy MinIO names configure authenticated SeaweedFS. Match API S3 access credentials.
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=graqivo_local
MINIO_ROOT_PASSWORD=REPLACE_WITH_LOCAL_STORAGE_PASSWORD
