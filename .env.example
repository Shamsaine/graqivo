# Root environment: local Compose and hosted infrastructure references.
# Keep secrets in ignored .env files or the deployment provider secret manager.

# Local PostgreSQL / Compose
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
POSTGRES_PORT=55439

# Local private storage / Compose
MINIO_ROOT_USER=graqivo_local
MINIO_ROOT_PASSWORD=REPLACE_WITH_LOCAL_STORAGE_PASSWORD

# Hosted Neon references. The API deployment uses these values; they are not
# consumed by Docker Compose.
NEON_DATABASE_URL=
NEON_DIRECT_DATABASE_URL=

# Hosted Cloudflare R2 references. Keep the bucket private.
R2_ACCOUNT_ID=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
